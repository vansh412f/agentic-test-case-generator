# Dependencies
node_modules/

# Production builds & compiled outputs
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets
.env
.env*.local
*.local
*.pem

# Logs
npm-debug.log*
pnpm-debug.log*
**/logs/*
!**/logs/.gitkeep

# Playwright Runner generated artifacts
**/playwright-runner/test-results/
**/playwright-runner/results.json
**/playwright-runner/tsconfig.run-*.json
**/playwright-runner/tests/*
!**/playwright-runner/tests/.gitkeep

# Vercel & hosting
.vercel/

# Editor directories and files
.idea/
.vscode/
*.sw?

# OS generated files
.DS_Store
Thumbs.db
powershell.cmd
**/powershell.cmd
.freebuff/


# Ephemeral rerun traces (1h TTL, may contain typed values)
**/playwright-runner/.traces/

backend/scratch/measure_results.json
backend/scratch/model_benchmark_results.json
backend/scratch/model_benchmark_fixtures.json
