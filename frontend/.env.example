# URL of the backend API server (e.g. http://localhost:4000 or production Render URL)
BACKEND_URL=http://localhost:4000
# Shared secret sent in x-agt-edge-secret header for client IP verification (min 24 chars)
EDGE_SHARED_SECRET=
# Canonical public URL of the frontend application (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Deployment mode indicator fallback: 'local' or 'hosted' (optional fallback while querying backend /api/health)
NEXT_PUBLIC_DEPLOYMENT_MODE=local
# Optional direct backend origin for SSE streams, bypassing edge rewrite (e.g. https://api.example.com)
NEXT_PUBLIC_STREAM_ORIGIN=
# Optional Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Optional Google Search Console HTML verification token
NEXT_PUBLIC_GSC_VERIFICATION=
