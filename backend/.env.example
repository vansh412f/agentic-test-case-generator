# Server port for HTTP API
PORT=4000
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development
# Launch visible headed browser during local development/debugging (default false)
HEADED_DEBUG=false
# Maximum interactive elements extracted per crawled page (default 200)
MAX_ELEMENTS_PER_PAGE=200
# Timeout in milliseconds for page navigation and load (default 30000)
NAVIGATION_TIMEOUT_MS=30000
# Wait time in milliseconds for network quiescence during crawl (default 3000)
NETWORK_IDLE_WAIT_MS=3000

# LLM provider API keys (at least one required in production)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# LLM provider models and fallback sequence
# Primary reasoning model on Groq
GROQ_REASONING_MODEL=openai/gpt-oss-120b
# Fast correction/generator model on Groq
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Primary reasoning model for Gemini fallback
GEMINI_REASONING_MODEL=gemini-2.5-flash
# Fast correction model for Gemini fallback
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Fast model for NVIDIA fallback
NVIDIA_MODEL=openai/gpt-oss-20b
# Fallback provider execution sequence (comma-separated)
LLM_PROVIDER_ORDER=groq,gemini,nvidia

# Database connections
# Supavisor transaction pooler connection string (port 6543) for runtime queries
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&connect_timeout=3&pool_timeout=3&socket_timeout=5&sslmode=require
# Direct database connection string (port 5432) for running migrations
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?connect_timeout=10&sslmode=require

# Security secrets (required in production, min 24 chars for admin/edge secrets)
# Secret for HMAC-signing visitor session tokens (min 16 chars)
VISITOR_SIGNING_SECRET=
# Secret for generating and validating proof-of-work challenges (min 16 chars)
POW_SECRET=
# Secret header token for admin endpoints (/api/admin/*, min 24 chars)
ADMIN_SECRET=
# Secret shared between frontend edge middleware and backend for client IP validation (min 24 chars)
EDGE_SHARED_SECRET=
# Allowed frontend origin URL for CORS and edge rewrites (e.g. http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Rate limits and quotas
# Global daily cap for free test generation jobs across all users (default 40)
GENERATE_DAILY_LIMIT=40
# Daily free test generation jobs allowed per visitor cookie (default 8)
FREE_VISITOR_DAILY_LIMIT=8
# Daily free test generation jobs allowed per client IP address (default 20)
FREE_IP_DAILY_LIMIT=20
# Maximum URLs crawled per test generation run on free tier (default 3)
FREE_MAX_URLS_PER_RUN=3
# Maximum URLs crawled per test generation run when BYOK keys are provided (default 5)
BYOK_MAX_URLS_PER_RUN=5
# Daily page crawl limit per client IP address (default 40)
CRAWL_DAILY_LIMIT_PER_IP=40
# Daily proof-of-work challenge limit per client IP address (default 200)
POW_DAILY_LIMIT_PER_IP=200
# Daily BYOK key validation requests per client IP address (default 50)
BYOK_VALIDATE_DAILY_LIMIT_PER_IP=50

# Pipeline concurrency and queue limits
# Maximum concurrent test execution pipelines running in parallel (default 1)
PIPELINE_CONCURRENCY=1
# Maximum concurrent crawl browser operations (default 1)
CRAWL_CONCURRENCY=1
# Maximum waiting job groups in queue before rejecting submissions (default 5)
QUEUE_MAX_WAITING_GROUPS=5
# Number of reverse proxy hops to trust for client IP extraction (default 1)
TRUST_PROXY_HOPS=1
# Timeout scale multiplier for Playwright runner and validator on low-CPU hosts (default 1, Render 3)
RUNNER_TIMEOUT_SCALE=1
# Token budget cap per test generation job pipeline execution (default 40000)
JOB_TOKEN_BUDGET=40000

# Pipeline features and flags
# Automatically inject baseline tests for HTTP status and uncaught JS errors (default true)
BASELINE_TESTS=true
# Automatically inject WCAG 2 A/AA accessibility smoke tests with axe-core (default true)
A11Y_SMOKE=true
# Host suffixes indicating sleeping free-tier servers that need wake detection (comma-separated)
WAKING_HOST_SUFFIXES=onrender.com,koyeb.app,up.railway.app,fly.dev,hf.space,glitch.me,replit.app
# Disable egress proxy and sandbox restrictions for trusted local development runs (default false)
LOCAL_AGENT_MODE=false