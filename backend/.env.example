PORT=4000
NODE_ENV=development
# HEADED_DEBUG=true (default false; set true to launch visible browser during local dev/debugging)
MAX_ELEMENTS_PER_PAGE=200
NAVIGATION_TIMEOUT_MS=30000
NETWORK_IDLE_WAIT_MS=3000

# LLM provider API keys (set at least one for server runs)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# LLM provider models, tiers, and fallback order
GROQ_REASONING_MODEL=openai/gpt-oss-120b # Default reasoning model for Groq (Groq free tier: ~7,500 TPM)
GROQ_FAST_MODEL=openai/gpt-oss-20b # Default fast model for Groq corrections/generator fallback
GEMINI_REASONING_MODEL=gemini-2.5-flash # Default reasoning model for Gemini (free tier: 15 RPM, 1M TPM)
GEMINI_FAST_MODEL=gemini-2.5-flash-lite # Default fast model for Gemini corrections/fallback (free tier: 15 RPM)
NVIDIA_MODEL=openai/gpt-oss-20b # Default model for NVIDIA API (free credits on build.nvidia.com)
LLM_PROVIDER_ORDER=groq,gemini,nvidia # Comma-separated provider fallback sequence

# Supavisor transaction pooler (runtime); URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&connect_timeout=3&pool_timeout=3&socket_timeout=5&sslmode=require
# Direct migration connection; use a session-pooler URL on 5432 if IPv6 is unavailable.
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?connect_timeout=10&sslmode=require

# Visitor sessions & limits
VISITOR_SIGNING_SECRET=
POW_SECRET=
GENERATE_DAILY_LIMIT=40          # global free jobs per UTC day (existing key, new default)
FREE_VISITOR_DAILY_LIMIT=8
FREE_IP_DAILY_LIMIT=20           # high enough for shared mobile-network IPs
FREE_MAX_URLS_PER_RUN=3
BYOK_MAX_URLS_PER_RUN=5          # max 5 = MAX_URLS_PER_RUN
CRAWL_DAILY_LIMIT_PER_IP=40
POW_DAILY_LIMIT_PER_IP=200
BYOK_VALIDATE_DAILY_LIMIT_PER_IP=50
LOCAL_AGENT_MODE=false
# Optional custom frontend origin allowed in local agent mode (e.g. custom domain)
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1
PIPELINE_CONCURRENCY=1
CRAWL_CONCURRENCY=1
QUEUE_MAX_WAITING_GROUPS=5
BASELINE_TESTS=true
A11Y_SMOKE=true